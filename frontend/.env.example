# Copy this file to `.env` and fill the values from your Microsoft Entra
# App registration (Overview page). Client id is not a secret.
#   Application (client) ID -> VITE_AAD_CLIENT_ID
#   Directory (tenant) ID   -> VITE_AAD_TENANT_ID   (single-tenant: use the GUID, not "common")
VITE_AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AAD_TENANT_ID=00000000-0000-0000-0000-000000000000

# Absolute origin of the API. Leave EMPTY for on-prem/dev — the SPA and the API share an
# origin there, so calls stay relative (`/api/v1`) and the Vite dev proxy keeps working.
# Set it only when the SPA is hosted apart from the API (Azure Static Web Apps), e.g.
#   VITE_API_BASE_URL=https://qtm-api-xxxx.azurewebsites.net
# The value is baked in at `npm run build`, so the CI job that builds for Azure must set it.
VITE_API_BASE_URL=
